# Copy this file to .env.local and fill in real values.
# Find both in your Supabase project: Project Settings → API.

# Safe to expose to the browser (protected by Row Level Security, not secrecy).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER expose this one to the browser or commit it. Only used by scripts/seed.mjs,
# run locally from your own machine — not part of the deployed app.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
